{
  "name": "courtscribe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,ws,docs -c blue,magenta,green \"vite\" \"tsx watch server/index.ts\" \"tsx watch server/documents.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "oxlint src shared server e2e",
    "test:e2e": "playwright test",
    "dev:docs": "tsx watch server/documents.ts"
  },
  "dependencies": {
    "@antv/g2plot": "^2.4.35",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/extension-collaboration": "^3.34.0",
    "@tiptap/extension-collaboration-caret": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tus/file-store": "^2.1.2",
    "@tus/server": "^2.4.7",
    "fflate": "^0.8.3",
    "lib0": "^0.2.120",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tus-js-client": "^4.3.1",
    "wavesurfer.js": "^8.1.0",
    "ws": "^8.23.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
