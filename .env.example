# Live Feed stream server. Unset on a non-localhost deployment (or "local") = speech runs in the browser only.
# VITE_STREAM_URL=wss://stream.example.com

# Document server (uploads, downloads, editor collaboration).
# Unset on localhost = http://localhost:8788. Unset elsewhere, or "browser" = browser-only mode (IndexedDB).
# VITE_DOC_SERVER_URL=https://docs.example.com
# VITE_UPLOAD_CHUNK_MB=5
# VITE_MAX_UPLOAD_MB=250

# Document server process (server/documents.ts)
# DOC_PORT=8788
# DOC_MAX_FILE_MB=250
# DOC_ALLOWED_ORIGINS=https://courtscribe.example.com
